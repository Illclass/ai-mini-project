# 환경변수 목록 (실제 값이 든 .env는 Git에 올리지 않음)
# ※ 서비스마다 .env를 읽는 위치가 다름 → README.md "환경변수" 참고

# ---- rag-service/.env ----
OPENAI_API_KEY=sk-...
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# JWT_SECRET=          # auth-server 와 같은 값 (dev.sh 로 실행하면 자동 전달)
# LLM_MODEL=gpt-4o
# EMBEDDING_MODEL=      # 비우면 bge-m3 (로컬). OpenAI 를 쓰려면 text-embedding-3-large. 바꾸면 ./ingest_all.sh 로 재적재
# ASYNC_DB_URL=mysql+aiomysql://root:password@127.0.0.1:53301/sql_db?charset=utf8mb4

# ---- voice-service/app/.env ----
# OPENAI_API_KEY=sk-...
# WHISPER_MODEL=small

# ---- auth-server (.env 파일이 아니라 셸 환경변수로 export) ----
# export JWT_SECRET=change-me
# export DB_PASSWORD=change-me

# 주의: voice-service/app/main.py 는 SECRET_KEY 가 "RANDOM_SECRET_KEY" 로 하드코딩되어 있음
#       Java 와 같은 값이어야 토큰 검증이 통과하므로, 둘을 맞추거나 코드에서 JWT_SECRET 을 읽도록 수정
